# ==============================================================================
# GLOBAL DIGITAL MONUMENT — ENVIRONMENT CONFIGURATION
# Copy to .env.local to configure your local or production deployment.
# ==============================================================================

# Application Mode: 'demo' (default simulated mode) or 'production' (real database & payment checkout)
NEXT_PUBLIC_APP_MODE=demo

# Supabase Managed PostgreSQL Configuration
# Public URL & Anon Key (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-Side Supabase Service Role Key (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Payment Gateway Provider: 'razorpay' (standard for INR) or 'stripe'
PAYMENT_PROVIDER=razorpay

# Razorpay Configuration (INR default)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Stripe Configuration (Alternative)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ==============================================================================
# PUBLIC TRUST & LEGAL CONFIGURATION (Safe, non-secret owner configuration)
# ==============================================================================
# Customer support email for public display and contact
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Legal operating entity name (Leave unconfigured or set registered business name)
# NEXT_PUBLIC_LEGAL_ENTITY_NAME=Global Digital Monument Pvt. Ltd.

# Registered physical or correspondence address
# NEXT_PUBLIC_BUSINESS_ADDRESS=123 Innovation Boulevard, Tech Park, City, State, PIN

# Legal governing jurisdiction for Terms of Service (e.g. Bangalore, India)
# NEXT_PUBLIC_GOVERNING_JURISDICTION=Bangalore, Karnataka, India

# Optional customer support phone number
# NEXT_PUBLIC_SUPPORT_PHONE=+91 98765 43210

# Refund review request window in calendar days (Default: 7)
# NEXT_PUBLIC_REFUND_WINDOW_DAYS=7

